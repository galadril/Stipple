# SPDX-License-Identifier: GPL-3.0-or-later
#
# Second ARMv7 cross-toolchain, for dynamically linked *executables*.
#
# The bookworm image next door is the main one and builds everything that
# matters: notrix_core, and the eventual libnotrix.so that zkgui loads. Shared
# libraries carry no startup files, so they only ask for GLIBC_2.4 and run
# anywhere.
#
# Executables are the exception. Their crt files reference __libc_start_main,
# which glibc re-versioned to GLIBC_2.34 in glibc 2.34 — so any executable built
# on Debian 12 demands a glibc newer than the TC002's 2.30 and refuses to start.
# Static linking dodges that, and does for the smoke test, but a static binary
# cannot dlopen the vendor HAL, which is exactly what a probe needs to do.
#
# Bullseye ships glibc 2.31: after nothing we need, before the re-versioning.
# Its executables ask for the old __libc_start_main@GLIBC_2.4 and load fine on a
# 2.30 device — which tooling/probe/abi-check.py confirms per artifact rather
# than leaving to this comment.
#
# Pinned by digest for the same reason as the other image: a tag can be
# repointed, and a toolchain that changes without anyone choosing to change it
# is how a device build stops matching what was tested.
FROM docker.io/library/debian@sha256:70509c95d1857a3704c0a5d92ee2e0adac95f612a9386889d70760bfd7c1ebba AS toolchain

# Just the compiler, not crossbuild-essential-armhf.
#
# That metapackage drags in dpkg-dev and therefore perl, and bullseye's perl has
# had security updates since this image was built — so the pinned package index
# names versions the archive no longer carries, and the build dies on a 404 for
# something it never needed. Nothing here builds a Debian package, and the only
# something it never needed. Nothing here builds a Debian package.
#
# cmake and ninja are here because this image stopped being the one that
# compiles a single file. notrix_device has to be dynamically linked to
# reach the speaker - /lib/libmi_ao.so is the only route to it, and a
# static binary cannot dlopen - so the firmware itself is built here now.
# The bookworm image still builds shared libraries and anything static.
# Bullseye is oldstable, and its security updates have moved off
# deb.debian.org into the archive. The pinned index still names them, so an
# install that needs any of them - cmake needs libcurl, libexpat and
# libnghttp2 - dies on a 404 for a file that exists, just somewhere else.
#
# archive.debian.org serves the frozen bullseye pool, where every version the
# pinned index names still exists. That fixes it without unpinning the base
# image, which is the thing worth keeping fixed. Security updates are not
# served from the archive, and are not wanted here: a reproducible toolchain
# is the point, and nothing in this image is exposed to a network.
RUN echo 'deb http://archive.debian.org/debian bullseye main' > /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99archive

RUN apt-get update && apt-get install --no-install-recommends --yes \
        g++-arm-linux-gnueabihf \
        cmake \
        ninja-build \
        file \
    && rm -rf /var/lib/apt/lists/*

RUN arm-linux-gnueabihf-gcc --version | head -1 && \
    arm-linux-gnueabihf-gcc -print-file-name=libc.so.6 && \
    cmake --version | head -1

WORKDIR /src
